<p class="mb-3"><%= link_to "← Models", model_configs_path, class: "nav-link" %></p>

<div class="flex items-start justify-between mb-6">
  <div>
    <h1 class="text-2xl font-semibold">
      <%= @model_config.name %>
      <% if @model_config.is_default? %><span class="pill pill-green">★ default</span><% end %>
    </h1>
    <p class="text-sm text-zinc-600 mt-1">
      <span class="pill"><%= @model_config.provider %></span>
      &middot; <code class="font-mono text-xs"><%= @model_config.model_id %></code>
      &middot; <%= @prediction_count %> predictions
    </p>
  </div>
  <%= link_to "Edit", edit_model_config_path(@model_config), class: "btn btn-primary" %>
</div>

<div class="card">
  <h2 class="card-title">Prompt template</h2>
  <pre class="bg-zinc-100 rounded-md p-3 overflow-auto text-xs whitespace-pre-wrap"><%= @model_config.prompt_template %></pre>
</div>
