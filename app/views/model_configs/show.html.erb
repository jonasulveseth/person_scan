<%= link_to model_configs_path, class: "back-link" do %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
  Models
<% end %>

<div class="flex flex-wrap items-start justify-between gap-3 mb-8">
  <div>
    <h1 class="page-title flex items-center gap-3">
      <%= @model_config.name %>
      <% if @model_config.is_default? %><span class="pill pill-green text-sm">★ default</span><% end %>
    </h1>
    <p class="page-subtitle">
      <span class="pill"><%= @model_config.provider %></span>
      <span class="text-stone-300">·</span>
      <code class="font-mono text-xs text-amber-800"><%= @model_config.model_id %></code>
      <span class="text-stone-300">·</span>
      <%= @prediction_count %> predictions
    </p>
  </div>
  <%= link_to "Edit", edit_model_config_path(@model_config), class: "btn btn-primary" %>
</div>

<div class="card">
  <h2 class="card-title">Prompt template</h2>
  <pre class="code-block whitespace-pre-wrap"><%= @model_config.prompt_template %></pre>
</div>
