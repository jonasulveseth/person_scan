<%= form_with model: @model_config, class: "space-y-5" do |f| %>
  <% if @model_config.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-3">
      <ul class="text-sm text-red-800 list-disc list-inside">
        <% @model_config.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="card space-y-4">
    <div>
      <%= f.label :name, class: "label" %>
      <span class="text-xs text-stone-500">Internal identifier, e.g. "nebius-llama-3.3-70b"</span>
      <%= f.text_field :name, required: true, class: "input mt-1" %>
    </div>

    <div>
      <%= f.label :provider, class: "label" %>
      <%= f.select :provider, @provider_options.map { |p, lbl| ["#{p} — #{lbl}", p] }, { prompt: "Choose…" }, class: "select" %>
    </div>

    <div>
      <%= f.label :model_id, class: "label" %>
      <span class="text-xs text-stone-500">Provider-specific identifier, e.g. <code>meta-llama/Llama-3.3-70B-Instruct</code>, <code>gpt-4o-mini</code>, <code>claude-sonnet-4-6</code></span>
      <%= f.text_field :model_id, required: true, class: "input mt-1 font-mono text-xs" %>
    </div>

    <div class="flex gap-6">
      <label class="flex items-center gap-2 text-sm">
        <%= f.check_box :active %> Active
      </label>
      <label class="flex items-center gap-2 text-sm">
        <%= f.check_box :is_default %> Set as system default
      </label>
    </div>
  </div>

  <div class="card">
    <%= f.label :prompt_template, "Prompt template (system message)", class: "label" %>
    <p class="text-xs text-stone-500 mb-2">Sent as the <code>system</code> message before each visitor's features JSON.</p>
    <%= f.text_area :prompt_template, rows: 22, required: true, class: "textarea font-mono text-xs" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", model_configs_path, class: "btn" %>
  </div>
<% end %>
