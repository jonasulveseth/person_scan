<%= form_with model: @model_config do |f| %>
  <% if @model_config.errors.any? %>
    <ul style="color:red">
      <% @model_config.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>

  <p>
    <%= f.label :name %> (internal identifier, e.g. "nebius-llama-3.3-70b")<br>
    <%= f.text_field :name, required: true, size: 40 %>
  </p>

  <p>
    <%= f.label :provider %><br>
    <%= f.select :provider, @provider_options.map { |p, lbl| ["#{p} — #{lbl}", p] }, { prompt: "Choose…" } %>
  </p>

  <p>
    <%= f.label :model_id %> (provider-specific model identifier, e.g. <code>meta-llama/Llama-3.3-70B-Instruct</code>, <code>gpt-4o-mini</code>, <code>claude-sonnet-4-6</code>)<br>
    <%= f.text_field :model_id, required: true, size: 60 %>
  </p>

  <p>
    <%= f.label :prompt_template %> (used as <code>system</code> message)<br>
    <%= f.text_area :prompt_template, rows: 18, cols: 100, required: true %>
  </p>

  <p>
    <%= f.check_box :active %> <%= f.label :active %><br>
    <%= f.check_box :is_default %> <%= f.label :is_default, "Set as system default" %>
  </p>

  <p><%= f.submit %></p>
<% end %>
