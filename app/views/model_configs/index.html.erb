<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold">Model configurations</h1>
  <%= link_to "+ Add model", new_model_config_path, class: "btn btn-primary" %>
</div>

<p class="text-sm text-zinc-600 mb-4">Each <strong>site</strong> can override its model on the site edit page. Otherwise the <strong>★ default</strong> below is used.</p>

<div class="card mb-6">
  <h2 class="card-title">Provider connectivity</h2>
  <div class="flex flex-wrap gap-3">
    <% @provider_status.each do |provider, has_key| %>
      <span class="pill <%= has_key ? "pill-green" : "pill-amber" %>">
        <%= provider %> · <%= has_key ? "key configured" : "no key" %>
      </span>
    <% end %>
  </div>
  <p class="text-xs text-zinc-500 mt-2">Add keys via <code>bin/rails credentials:edit</code> under their provider key (<code>nebius.api_key</code>, <code>openai.api_key</code>, <code>anthropic.api_key</code>).</p>
</div>

<div class="card p-0 overflow-hidden">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Provider</th>
        <th>Model ID</th>
        <th>Active</th>
        <th>Default</th>
        <th>Predictions</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @model_configs.each do |m| %>
        <tr>
          <td><%= link_to m.name, m, class: "font-medium hover:underline" %></td>
          <td>
            <%= m.provider %>
            <% unless @provider_status[m.provider] %><span class="pill pill-amber">no key</span><% end %>
          </td>
          <td class="font-mono text-xs text-zinc-600"><%= m.model_id %></td>
          <td><%= m.active? ? content_tag(:span, "yes", class: "pill pill-green") : content_tag(:span, "no", class: "pill") %></td>
          <td>
            <% if m.is_default? %>
              <span class="pill pill-green">★ default</span>
            <% else %>
              <%= button_to "Make default", make_default_model_config_path(m), method: :post, class: "btn btn-sm" %>
            <% end %>
          </td>
          <td><%= m.predictions.count %></td>
          <td class="text-right">
            <%= link_to "Edit", edit_model_config_path(m), class: "btn btn-sm" %>
            <%= button_to "Delete", model_config_path(m), method: :delete, data: { turbo_confirm: "Sure?" }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
