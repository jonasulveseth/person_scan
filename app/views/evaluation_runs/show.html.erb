<p class="mb-3"><%= link_to "← Evaluations", evaluation_runs_path, class: "nav-link" %></p>

<h1 class="text-2xl font-semibold mb-1">Evaluation run #<%= @run.id %></h1>
<p class="text-sm text-zinc-600 mb-6">
  Model: <strong><%= @run.model_config.name %></strong>
  <span class="text-xs text-zinc-500">(<%= @run.model_config.provider %>/<%= @run.model_config.model_id %>)</span>
  &middot; <%= @run.started_at %>
</p>

<% age_eval = @run.results.is_a?(Hash) ? @run.results["age_evaluated"].to_i : 0 %>
<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
  <div class="card">
    <div class="text-xs uppercase tracking-wider text-zinc-500">Examples</div>
    <div class="text-2xl font-semibold mt-1"><%= @run.total %></div>
  </div>
  <div class="card">
    <div class="text-xs uppercase tracking-wider text-zinc-500">Gender accuracy</div>
    <div class="text-2xl font-semibold mt-1"><%= @run.accuracy_gender ? "#{(@run.accuracy_gender * 100).round(1)}%" : "—" %></div>
    <div class="text-xs text-zinc-500 mt-1"><%= @run.correct_gender %>/<%= @run.total %></div>
  </div>
  <div class="card">
    <div class="text-xs uppercase tracking-wider text-zinc-500">Age accuracy</div>
    <div class="text-2xl font-semibold mt-1"><%= age_eval.positive? ? "#{(@run.correct_age_bracket.to_f / age_eval * 100).round(1)}%" : "—" %></div>
    <div class="text-xs text-zinc-500 mt-1"><%= @run.correct_age_bracket %>/<%= age_eval %></div>
  </div>
  <div class="card">
    <div class="text-xs uppercase tracking-wider text-zinc-500">Avg confidence</div>
    <div class="text-2xl font-semibold mt-1"><%= (@run.avg_confidence.to_f * 100).round(1) %>%</div>
  </div>
</div>

<div class="card p-0 overflow-hidden">
  <div class="px-5 py-3 border-b border-zinc-200">
    <h2 class="text-base font-semibold">Per-example breakdown</h2>
  </div>
  <% items = @run.results.is_a?(Hash) ? @run.results["examples"] || [] : [] %>
  <table class="table">
    <thead>
      <tr>
        <th>Example</th>
        <th>Truth</th>
        <th>Predicted</th>
        <th>Label</th>
        <th class="text-right">Conf</th>
      </tr>
    </thead>
    <tbody>
      <% items.each do |r| %>
        <tr>
          <td><%= link_to "##{r["training_example_id"]}", training_example_path(r["training_example_id"]), class: "font-mono text-xs hover:underline" rescue "##{r["training_example_id"]}" %></td>
          <% if r["error"] %>
            <td colspan="4" class="text-red-700 text-xs"><%= r["error"] %></td>
          <% else %>
            <td class="text-xs">
              <span><%= r.dig("truth", "gender") %></span> /
              <span><%= r.dig("truth", "age_bracket") || "?" %></span>
            </td>
            <td class="text-xs">
              <%= content_tag :span, r.dig("predicted", "gender"), class: (r["gender_ok"] ? "pill pill-green" : "pill pill-red") %>
              <%= content_tag :span, r.dig("predicted", "age_bracket"), class: (r["age_ok"] ? "pill pill-green" : "pill pill-red") %>
            </td>
            <td><%= r.dig("predicted", "label") %></td>
            <td class="text-right"><%= (r.dig("predicted", "confidence").to_f * 100).round %>%</td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
