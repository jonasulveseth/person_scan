<%= link_to evaluation_runs_path, class: "back-link" do %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
  Evaluations
<% end %>

<div class="mb-8">
  <h1 class="page-title">Evaluation run <span class="text-stone-400">#<%= @run.id %></span></h1>
  <p class="page-subtitle">
    Model: <strong class="text-stone-700"><%= @run.model_config.name %></strong>
    <span class="text-stone-400">(<%= @run.model_config.provider %>/<%= @run.model_config.model_id %>)</span>
    <span class="text-stone-300">·</span> <%= @run.started_at %>
  </p>
</div>

<% age_eval = @run.results.is_a?(Hash) ? @run.results["age_evaluated"].to_i : 0 %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="stat-card">
    <div class="stat-label">Examples</div>
    <div class="stat-value"><%= @run.total %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Gender accuracy</div>
    <div class="stat-value"><%= @run.accuracy_gender ? "#{(@run.accuracy_gender * 100).round(1)}%" : "—" %></div>
    <div class="stat-meta"><%= @run.correct_gender %>/<%= @run.total %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Age accuracy</div>
    <div class="stat-value"><%= age_eval.positive? ? "#{(@run.correct_age_bracket.to_f / age_eval * 100).round(1)}%" : "—" %></div>
    <div class="stat-meta"><%= @run.correct_age_bracket %>/<%= age_eval %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Avg confidence</div>
    <div class="stat-value"><%= (@run.avg_confidence.to_f * 100).round(1) %>%</div>
  </div>
</div>

<div class="card p-0 overflow-hidden">
  <div class="px-5 py-3 border-b border-stone-200 bg-stone-50/60">
    <h2 class="text-base font-semibold tracking-tight">Per-example breakdown</h2>
  </div>
  <% items = @run.results.is_a?(Hash) ? @run.results["examples"] || [] : [] %>
  <table class="table">
    <thead>
      <tr>
        <th>Example</th>
        <th>Truth</th>
        <th>Predicted</th>
        <th>Label</th>
        <th class="text-right">Conf</th>
      </tr>
    </thead>
    <tbody>
      <% items.each do |r| %>
        <tr>
          <td><%= link_to "##{r["training_example_id"]}", training_example_path(r["training_example_id"]), class: "font-mono text-xs hover:underline" rescue "##{r["training_example_id"]}" %></td>
          <% if r["error"] %>
            <td colspan="4" class="text-red-700 text-xs"><%= r["error"] %></td>
          <% else %>
            <td class="text-xs">
              <span><%= r.dig("truth", "gender") %></span> /
              <span><%= r.dig("truth", "age_bracket") || "?" %></span>
            </td>
            <td class="text-xs">
              <%= content_tag :span, r.dig("predicted", "gender"), class: (r["gender_ok"] ? "pill pill-green" : "pill pill-red") %>
              <%= content_tag :span, r.dig("predicted", "age_bracket"), class: (r["age_ok"] ? "pill pill-green" : "pill pill-red") %>
            </td>
            <td><%= r.dig("predicted", "label") %></td>
            <td class="text-right"><%= (r.dig("predicted", "confidence").to_f * 100).round %>%</td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
