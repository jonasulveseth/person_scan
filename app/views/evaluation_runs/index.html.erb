<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold">Evaluations</h1>
</div>

<div class="card mb-6">
  <h2 class="card-title">Start a new evaluation</h2>
  <p class="text-xs text-zinc-500 mb-3">Runs synchronously, calls the LLM N times. Start with a small N (10–30).</p>
  <%= form_with url: evaluation_runs_path, method: :post, class: "flex flex-wrap items-end gap-3" do %>
    <div class="flex-1 min-w-48">
      <label class="label">Model</label>
      <%= select_tag "model_config_id", options_from_collection_for_select(@models, :id, :name), class: "select" %>
    </div>
    <div class="w-32">
      <label class="label">Sample size</label>
      <%= number_field_tag "limit", 20, min: 1, max: 500, class: "input" %>
    </div>
    <%= submit_tag "Run evaluation", class: "btn btn-primary" %>
  <% end %>
</div>

<h2 class="text-lg font-semibold mb-3">Past runs</h2>
<% if @runs.empty? %>
  <div class="card text-center text-sm text-zinc-500">None yet.</div>
<% else %>
  <div class="card p-0 overflow-hidden">
    <table class="table">
      <thead>
        <tr>
          <th>When</th>
          <th>Model</th>
          <th class="text-right">N</th>
          <th class="text-right">Gender acc</th>
          <th class="text-right">Age acc</th>
          <th class="text-right">Avg conf</th>
        </tr>
      </thead>
      <tbody>
        <% @runs.each do |r| %>
          <tr>
            <td><%= link_to r.started_at&.strftime("%Y-%m-%d %H:%M"), r, class: "hover:underline" %></td>
            <td class="text-xs text-zinc-600"><%= r.model_config.name %></td>
            <td class="text-right"><%= r.total %></td>
            <td class="text-right font-medium"><%= r.accuracy_gender ? "#{(r.accuracy_gender * 100).round(1)}%" : "—" %></td>
            <td class="text-right font-medium"><%= r.accuracy_age_bracket ? "#{(r.accuracy_age_bracket * 100).round(1)}%" : "—" %></td>
            <td class="text-right"><%= (r.avg_confidence.to_f * 100).round(1) %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
