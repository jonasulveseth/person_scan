<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "individlabs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>body { font-family: 'Source Sans 3', system-ui, sans-serif; }</style>
  </head>

  <body class="h-full antialiased bg-gradient-to-b from-stone-950 to-stone-900 text-white min-h-screen">
    <header class="absolute top-0 left-0 right-0 z-20">
      <div class="mx-auto max-w-6xl px-5 py-5 flex items-center justify-between">
        <%= link_to splash_path, class: "block" do %>
          <%= image_tag "layout/individlabs-logo.png", alt: "individlabs",
              class: "h-[3.2rem] w-auto brightness-0 invert" %>
        <% end %>
        <nav class="flex items-center gap-5 text-sm text-white/80">
          <%= link_to "Pricing", pricing_path, class: "hover:text-white" %>
        </nav>
      </div>
    </header>

    <main class="min-h-screen flex items-center justify-center px-5 pt-28 pb-12">
      <div class="w-full max-w-md">
        <% if flash[:notice] %>
          <div class="mb-4 rounded-md border border-amber-400/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-100"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="mb-4 rounded-md border border-red-400/40 bg-red-500/10 px-4 py-3 text-sm text-red-200"><%= flash[:alert] %></div>
        <% end %>

        <%= yield %>
      </div>
    </main>

    <footer class="absolute bottom-0 left-0 right-0 text-center text-xs text-stone-500 py-4">
      © <%= Date.current.year %> individlabs
    </footer>
  </body>
</html>
