<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "individlabs — Know what your visitors are like" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { font-family: 'Source Sans 3', system-ui, sans-serif; }
      .hero-bg {
        background-image: url('<%= asset_path("landing/hero.jpg") %>');
        background-size: cover;
        background-position: center;
      }
      .hero-bubbles {
        background-image: url('<%= asset_path("landing/hero-bubbles.jpg") %>');
        background-size: cover;
        background-position: center;
        opacity: 0;
        animation: bubblesFade 1.8s ease-in 0.3s forwards;
      }
      @keyframes bubblesFade { to { opacity: 1; } }
      @media (max-width: 640px) {
        .hero-bg, .hero-bubbles {
          background-image: url('<%= asset_path("landing/hero-mobile.jpg") %>');
        }
      }
      @keyframes floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(12px); } }
      .floaty { animation: floaty 2.6s ease-in-out infinite; }
    </style>
  </head>

  <body class="text-zinc-900 antialiased">
    <header class="absolute top-0 left-0 right-0 z-20">
      <div class="mx-auto max-w-6xl px-5 py-5 flex items-center justify-between">
        <%= link_to splash_path, class: "block" do %>
          <%= image_tag "layout/individlabs-logo.png", alt: "individlabs", class: "h-[3.2rem] w-auto brightness-0 invert" %>
        <% end %>
        <nav class="flex items-center gap-5 text-sm text-white/90">
          <a href="<%= splash_path %>#how-it-works" class="hover:text-white">How it works</a>
          <%= link_to "Pricing", pricing_path, class: "hover:text-white" %>
          <%= link_to "Log in", login_path, class: "hover:text-white" %>
          <%= link_to "Get started", pricing_path, class: "rounded-md bg-white text-zinc-900 px-3 py-1.5 font-medium hover:bg-zinc-100" %>
        </nav>
      </div>
    </header>

    <%= yield %>

    <footer class="bg-zinc-900 text-zinc-400 text-sm">
      <div class="mx-auto max-w-6xl px-5 py-10 flex flex-wrap items-center justify-between gap-4">
        <p>© <%= Date.current.year %> individlabs</p>
        <nav class="flex gap-5">
          <%= link_to "Log in", login_path, class: "hover:text-white" %>
          <%= link_to "Pricing", pricing_path, class: "hover:text-white" %>
        </nav>
      </div>
    </footer>
  </body>
</html>
