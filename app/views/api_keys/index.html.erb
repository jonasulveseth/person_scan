<p><%= link_to "&larr; Site".html_safe, site_path(@site) %></p>

<h1>API keys for <%= @site.name %></h1>

<p>Use these in the <code>Authorization: Bearer ...</code> header when calling <code>/api/v1/...</code> for this site.</p>

<%= form_with url: site_api_keys_path(@site), method: :post, local: true do %>
  <%= text_field_tag :name, "", placeholder: "Key name (e.g. 'prod backend')", size: 30 %>
  <%= submit_tag "Generate new API key" %>
<% end %>

<% if @api_keys.any? %>
  <table border="1" cellpadding="6" cellspacing="0">
    <thead>
      <tr><th>Name</th><th>Token</th><th>Active</th><th>Last used</th><th>Created</th><th></th></tr>
    </thead>
    <tbody>
      <% @api_keys.each do |k| %>
        <tr<%= ' style="opacity:.5"'.html_safe unless k.active? %>>
          <td><%= k.name %></td>
          <td><code><%= k.masked %></code></td>
          <td><%= k.active? ? "yes" : "revoked" %></td>
          <td><%= k.last_used_at&.strftime("%Y-%m-%d %H:%M") || "—" %></td>
          <td><%= k.created_at.strftime("%Y-%m-%d") %></td>
          <td>
            <% if k.active? %>
              <%= button_to "Revoke", revoke_site_api_key_path(@site, k), method: :post, form: { style: "display:inline" } %>
            <% end %>
            <%= button_to "Delete", site_api_key_path(@site, k), method: :delete, data: { turbo_confirm: "Delete permanently?" }, form: { style: "display:inline" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No API keys yet.</p>
<% end %>
