<%= link_to site_path(@site), class: "back-link" do %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
  <%= @site.name %>
<% end %>

<div class="mb-8">
  <h1 class="page-title">API keys</h1>
  <p class="page-subtitle">Use these in <code class="text-amber-800">Authorization: Bearer …</code> when calling <code class="text-amber-800">/api/v1/…</code> for <strong class="text-stone-700"><%= @site.name %></strong>.</p>
</div>

<div class="card mb-6">
  <h2 class="card-title">Generate new key</h2>
  <%= form_with url: site_api_keys_path(@site), method: :post, class: "flex flex-wrap items-end gap-2" do %>
    <div class="flex-1 min-w-48">
      <label class="label">Key name</label>
      <%= text_field_tag :name, "", placeholder: "e.g. 'prod backend'", class: "input" %>
    </div>
    <%= submit_tag "Generate", class: "btn btn-primary" %>
  <% end %>
  <p class="text-xs text-stone-500 mt-2">The token will be shown once in the success banner — copy it immediately.</p>
</div>

<% if @api_keys.any? %>
  <div class="card p-0 overflow-hidden">
    <table class="table">
      <thead>
        <tr><th>Name</th><th>Token</th><th>Status</th><th>Last used</th><th>Created</th><th></th></tr>
      </thead>
      <tbody>
        <% @api_keys.each do |k| %>
          <tr<%= ' class="opacity-50"'.html_safe unless k.active? %>>
            <td class="font-medium"><%= k.name %></td>
            <td class="font-mono text-xs"><%= k.masked %></td>
            <td>
              <% if k.active? %>
                <span class="pill pill-green">active</span>
              <% else %>
                <span class="pill pill-red">revoked</span>
              <% end %>
            </td>
            <td class="text-xs text-stone-500"><%= k.last_used_at&.strftime("%Y-%m-%d %H:%M") || "—" %></td>
            <td class="text-xs text-stone-500"><%= k.created_at.strftime("%Y-%m-%d") %></td>
            <td class="text-right">
              <% if k.active? %>
                <%= button_to "Revoke", revoke_site_api_key_path(@site, k), method: :post, class: "btn btn-sm" %>
              <% end %>
              <%= button_to "Delete", site_api_key_path(@site, k), method: :delete, data: { turbo_confirm: "Delete permanently?" }, class: "btn btn-sm btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card text-center text-sm text-stone-500 py-10">No API keys yet.</div>
<% end %>
