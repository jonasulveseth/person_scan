<%= link_to back_link_path = sites_path, class: "back-link" do %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
  Sites
<% end %>

<div class="flex flex-wrap items-start justify-between gap-3 mb-8">
  <div>
    <h1 class="page-title"><%= @site.name %></h1>
    <p class="page-subtitle">
      <%= @site.url.presence || "(no URL set)" %>
      <span class="text-stone-300">·</span>
      Model: <span class="font-medium text-stone-700"><%= @site.effective_model_config&.name || "(none)" %></span>
      <%= content_tag :span, "site override", class: "pill pill-amber ml-1" if @site.model_config %>
    </p>
  </div>
  <div class="flex gap-2">
    <%= link_to "Trends", trends_site_path(@site), class: "btn" %>
    <%= link_to "API keys", site_api_keys_path(@site), class: "btn" %>
    <%= link_to "Edit", edit_site_path(@site), class: "btn btn-primary" %>
  </div>
</div>

<div class="card mb-6">
  <h2 class="card-title">Install snippet</h2>
  <p class="text-sm text-stone-600 mb-3">Add this to the bottom of your site's <code class="text-amber-800">&lt;body&gt;</code>:</p>
  <pre class="code-block"><%= @snippet %></pre>
</div>

<div class="card p-0 overflow-hidden">
  <div class="px-5 py-3 border-b border-stone-200 flex items-center justify-between bg-stone-50/60">
    <h2 class="text-base font-semibold tracking-tight">Recent visitors <span class="text-stone-400 font-normal">(<%= @site.visitors.count %> total)</span></h2>
  </div>

  <% if @visitors.empty? %>
    <p class="px-5 py-6 text-sm text-stone-600">No visitors recorded yet. Install the snippet above and load a page.</p>
  <% else %>
    <table class="table">
      <thead>
        <tr>
          <th>Fingerprint</th>
          <th>Last seen</th>
          <th>Events</th>
          <th>Personality</th>
          <th>Confidence</th>
        </tr>
      </thead>
      <tbody>
        <% @visitors.each do |v| %>
          <% pred = v.predictions.max_by(&:created_at) %>
          <tr>
            <td><%= link_to v.fingerprint[0, 12], site_visitor_path(@site, v), class: "font-mono text-xs text-stone-900 hover:underline" %></td>
            <td class="text-stone-600"><%= v.last_seen_at&.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= v.tracking_events.size + v.click_events.size + v.page_visits.size %></td>
            <td><%= pred ? pred.label : "—" %></td>
            <td><%= pred ? "#{(pred.confidence * 100).round}%" : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
