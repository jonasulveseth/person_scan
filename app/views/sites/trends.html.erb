<p class="mb-3"><%= link_to "← #{@site.name}", site_path(@site), class: "nav-link" %></p>

<h1 class="text-2xl font-semibold mb-1">Trends for <%= @site.name %></h1>
<p class="text-xs text-zinc-500 mb-6">Generated <%= @trends[:generated_at] %> &middot; last <%= SiteTrends::DAYS_BACK %> days where applicable.</p>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
  <div class="card">
    <div class="text-xs uppercase tracking-wider text-zinc-500">Total visitors</div>
    <div class="text-2xl font-semibold mt-1"><%= @trends[:visitors][:total] %></div>
    <div class="text-xs text-zinc-500 mt-1"><%= @trends[:visitors][:new_last_30d] %> new last 30d</div>
  </div>
  <div class="card">
    <div class="text-xs uppercase tracking-wider text-zinc-500">Predictions</div>
    <div class="text-2xl font-semibold mt-1"><%= @trends[:predictions][:total] %></div>
    <div class="text-xs text-zinc-500 mt-1">
      avg conf <%= @trends[:predictions][:avg_confidence] ? "#{(@trends[:predictions][:avg_confidence] * 100).round(1)}%" : "—" %>
    </div>
  </div>
  <div class="card">
    <div class="text-xs uppercase tracking-wider text-zinc-500">Click events</div>
    <div class="text-2xl font-semibold mt-1"><%= @trends[:events][:clicks] %></div>
    <div class="text-xs text-zinc-500 mt-1"><%= @trends[:events][:tracking] %> tracking batches</div>
  </div>
  <div class="card">
    <div class="text-xs uppercase tracking-wider text-zinc-500">Page visits</div>
    <div class="text-2xl font-semibold mt-1"><%= @trends[:events][:page_visits] %></div>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="card">
    <h2 class="card-title">Gender</h2>
    <table class="table">
      <thead><tr><th>Value</th><th class="text-right">Count</th></tr></thead>
      <tbody>
        <% @trends[:distributions][:gender].sort_by { |_, n| -n }.each do |k, n| %>
          <tr><td><%= k %></td><td class="text-right font-medium"><%= n %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">Age bracket</h2>
    <table class="table">
      <thead><tr><th>Bracket</th><th class="text-right">Count</th></tr></thead>
      <tbody>
        <% @trends[:distributions][:age_bracket].sort_by { |k, _| k.to_s }.each do |k, n| %>
          <tr><td><%= k %></td><td class="text-right font-medium"><%= n %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">Top personalities</h2>
    <table class="table">
      <thead><tr><th>Label</th><th class="text-right">Count</th></tr></thead>
      <tbody>
        <% @trends[:distributions][:label].each do |k, n| %>
          <tr><td><%= k %></td><td class="text-right font-medium"><%= n %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <div class="card">
    <h2 class="card-title">Average dimensions</h2>
    <dl class="space-y-2 text-sm">
      <% @trends[:avg_dimensions].each do |dim, val| %>
        <div class="flex items-center justify-between border-b border-zinc-100 last:border-0 py-1">
          <dt class="text-zinc-600 capitalize"><%= dim %></dt>
          <dd class="font-medium">
            <% if val %>
              <span class="inline-block w-10 text-right"><%= val %></span>
              <span class="inline-block w-32 h-1.5 bg-zinc-200 rounded-full overflow-hidden ml-2 align-middle">
                <span class="block h-full bg-zinc-900" style="width: <%= (val.to_f * 100).clamp(0, 100) %>%"></span>
              </span>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="card">
    <h2 class="card-title">Predictions per day (last <%= SiteTrends::DAYS_BACK %> days)</h2>
    <% if @trends[:time_series].empty? %>
      <p class="text-sm text-zinc-500">No data.</p>
    <% else %>
      <% max = @trends[:time_series].values.max.to_f %>
      <table class="table">
        <tbody>
          <% @trends[:time_series].each do |date, n| %>
            <tr>
              <td class="text-xs text-zinc-500 w-24"><%= date %></td>
              <td class="font-medium w-10"><%= n %></td>
              <td>
                <span class="inline-block h-2 bg-zinc-900 rounded-full" style="width: <%= max.zero? ? 0 : (n / max * 100).round %>%"></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
