<%= link_to site_path(@site), class: "back-link" do %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
  <%= @site.name %>
<% end %>

<div class="mb-8">
  <h1 class="page-title">Trends for <%= @site.name %></h1>
  <p class="page-subtitle">Generated <%= @trends[:generated_at] %> · last <%= SiteTrends::DAYS_BACK %> days where applicable.</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="stat-card">
    <div class="stat-label">Total visitors</div>
    <div class="stat-value"><%= @trends[:visitors][:total] %></div>
    <div class="stat-meta"><%= @trends[:visitors][:new_last_30d] %> new last 30d</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Predictions</div>
    <div class="stat-value"><%= @trends[:predictions][:total] %></div>
    <div class="stat-meta">
      avg conf <%= @trends[:predictions][:avg_confidence] ? "#{(@trends[:predictions][:avg_confidence] * 100).round(1)}%" : "—" %>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Click events</div>
    <div class="stat-value"><%= @trends[:events][:clicks] %></div>
    <div class="stat-meta"><%= @trends[:events][:tracking] %> tracking batches</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Page visits</div>
    <div class="stat-value"><%= @trends[:events][:page_visits] %></div>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="card">
    <h2 class="card-title">Gender</h2>
    <table class="table">
      <thead><tr><th>Value</th><th class="text-right">Count</th></tr></thead>
      <tbody>
        <% @trends[:distributions][:gender].sort_by { |_, n| -n }.each do |k, n| %>
          <tr><td><%= k %></td><td class="text-right font-medium"><%= n %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">Age bracket</h2>
    <table class="table">
      <thead><tr><th>Bracket</th><th class="text-right">Count</th></tr></thead>
      <tbody>
        <% @trends[:distributions][:age_bracket].sort_by { |k, _| k.to_s }.each do |k, n| %>
          <tr><td><%= k %></td><td class="text-right font-medium"><%= n %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2 class="card-title">Top personalities</h2>
    <table class="table">
      <thead><tr><th>Label</th><th class="text-right">Count</th></tr></thead>
      <tbody>
        <% @trends[:distributions][:label].each do |k, n| %>
          <tr><td><%= k %></td><td class="text-right font-medium"><%= n %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <div class="card">
    <h2 class="card-title">Average dimensions</h2>
    <dl class="space-y-2 text-sm">
      <% @trends[:avg_dimensions].each do |dim, val| %>
        <div class="flex items-center justify-between border-b border-stone-100 last:border-0 py-1">
          <dt class="text-stone-600 capitalize"><%= dim %></dt>
          <dd class="font-medium">
            <% if val %>
              <span class="inline-block w-10 text-right"><%= val %></span>
              <span class="inline-block w-32 h-1.5 bg-stone-200 rounded-full overflow-hidden ml-2 align-middle">
                <span class="block h-full bg-amber-800" style="width: <%= (val.to_f * 100).clamp(0, 100) %>%"></span>
              </span>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="card">
    <h2 class="card-title">Predictions per day (last <%= SiteTrends::DAYS_BACK %> days)</h2>
    <% if @trends[:time_series].empty? %>
      <p class="text-sm text-stone-500">No data.</p>
    <% else %>
      <% max = @trends[:time_series].values.max.to_f %>
      <table class="table">
        <tbody>
          <% @trends[:time_series].each do |date, n| %>
            <tr>
              <td class="text-xs text-stone-500 w-24"><%= date %></td>
              <td class="font-medium w-10"><%= n %></td>
              <td>
                <span class="inline-block h-2 bg-amber-800 rounded-full" style="width: <%= max.zero? ? 0 : (n / max * 100).round %>%"></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
