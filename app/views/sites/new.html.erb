<h1>New site</h1>

<%= form_with model: @site do |f| %>
  <% if @site.errors.any? %>
    <ul style="color:red">
      <% @site.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>
  <p><%= f.label :name %><br><%= f.text_field :name, required: true %></p>
  <p><%= f.label :url %> (optional)<br><%= f.url_field :url %></p>
  <p><%= f.submit "Create" %></p>
<% end %>

<p><%= link_to "Cancel", sites_path %></p>
