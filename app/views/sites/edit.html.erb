<p><%= link_to "&larr; Site".html_safe, site_path(@site) %></p>

<h1>Edit <%= @site.name %></h1>

<%= form_with model: @site do |f| %>
  <% if @site.errors.any? %>
    <ul style="color:red">
      <% @site.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>
  <p><%= f.label :name %><br><%= f.text_field :name, required: true %></p>
  <p><%= f.label :url %><br><%= f.url_field :url %></p>
  <p>
    <%= f.label :model_config_id, "Model" %><br>
    <%= f.collection_select :model_config_id, ModelConfig.active.order(:name), :id, :name, include_blank: "Use system default" %>
  </p>
  <p><%= f.check_box :active %> <%= f.label :active %></p>
  <p><%= f.submit "Save" %></p>
<% end %>
