<%= link_to training_examples_path, class: "back-link" do %>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
  Training data
<% end %>

<div class="flex flex-wrap items-start justify-between gap-3 mb-8">
  <div>
    <h1 class="page-title">Training example <span class="text-stone-400">#<%= @example.id %></span></h1>
    <p class="page-subtitle">
      <span class="pill"><%= @example.source %></span>
      <% if @example.visitor_id %>
        <span class="text-stone-300">·</span>
        <%= link_to "visitor #{@example.visitor_id}", site_visitor_path(@example.visitor.site, @example.visitor), class: "text-amber-800 hover:underline" %>
      <% end %>
      <% if @example.legacy_cookie_id %>
        <span class="text-stone-300">·</span>
        <span class="font-mono text-xs"><%= @example.legacy_cookie_id %></span>
      <% end %>
    </p>
  </div>
  <%= link_to "Edit", edit_training_example_path(@example), class: "btn btn-primary" %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <div class="card">
    <h2 class="card-title">Ground truth</h2>
    <dl class="space-y-1 text-sm">
      <% @example.ground_truth.each do |k, v| %>
        <div class="flex justify-between border-b border-stone-100 py-1"><dt class="text-stone-600"><%= k %></dt><dd class="font-medium"><%= v %></dd></div>
      <% end %>
    </dl>
  </div>

  <div class="card">
    <h2 class="card-title">Notes</h2>
    <p class="text-sm text-stone-700"><%= simple_format(@example.notes.to_s) %></p>
  </div>
</div>

<div class="card mt-4">
  <h2 class="card-title">Features</h2>
  <pre class="code-block"><%= JSON.pretty_generate(@example.features) %></pre>
</div>
