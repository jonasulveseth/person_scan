<h2 class="text-2xl font-semibold mb-1">Welcome back</h2>
<p class="text-sm text-stone-600 mb-6">Log in to your Person Scan account.</p>

<%= form_with url: session_path, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :email_address, class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>
  <div>
    <%= form.label :password, class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
  </div>
  <%= form.submit "Sign in", class: "btn btn-primary w-full" %>
<% end %>

<p class="mt-6 text-sm text-stone-600">
  <%= link_to "Forgot password?", new_password_path, class: "text-amber-800 hover:underline" %>
  &middot;
  <%= link_to "Create an account", signup_path, class: "text-amber-800 hover:underline" %>
</p>
