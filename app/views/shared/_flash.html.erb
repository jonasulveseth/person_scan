<%# Top-right toast container. Renders any flash[:notice] / flash[:alert]. %>
<% if flash.any? %>
  <div class="fixed top-4 right-4 z-50 flex flex-col gap-2 w-[min(92vw,22rem)] pointer-events-none">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <%
        styles = case type.to_s
        when "alert"
          { bar: "bg-red-500", icon_bg: "bg-red-50 text-red-600",
            icon: "M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" }
        else # notice / success / info
          { bar: "bg-emerald-500", icon_bg: "bg-emerald-50 text-emerald-600",
            icon: "M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" }
        end
      %>
      <div data-controller="flash"
           data-flash-delay-value="<%= type.to_s == 'alert' ? 7000 : 4500 %>"
           class="pointer-events-auto opacity-0 translate-x-4 transition-all duration-200 ease-out
                  flex items-start gap-3 rounded-lg bg-white shadow-lg ring-1 ring-stone-900/10
                  pl-0 pr-3 py-3 overflow-hidden">
        <div class="w-1 self-stretch <%= styles[:bar] %>"></div>
        <div class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full <%= styles[:icon_bg] %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= styles[:icon] %>"/>
          </svg>
        </div>
        <div class="flex-1 text-sm text-stone-800 pt-0.5"><%= message %></div>
        <button type="button" data-action="flash#dismiss"
                class="flex-none text-stone-400 hover:text-stone-700 transition" aria-label="Dismiss">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
