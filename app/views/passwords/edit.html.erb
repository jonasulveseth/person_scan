<h2 class="text-3xl font-light mb-1">Set a new password</h2>
<p class="text-sm text-stone-300 mb-6">Choose something you can remember.</p>

<%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :password, "New password", class: "block text-sm font-medium text-stone-200 mb-1" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
        class: "w-full rounded-md bg-white/5 border border-white/15 px-3 py-2 text-white focus:outline-none focus:border-amber-400 focus:bg-white/10" %>
  </div>
  <div>
    <%= form.label :password_confirmation, "Repeat new password", class: "block text-sm font-medium text-stone-200 mb-1" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
        class: "w-full rounded-md bg-white/5 border border-white/15 px-3 py-2 text-white focus:outline-none focus:border-amber-400 focus:bg-white/10" %>
  </div>
  <%= form.submit "Save",
      class: "w-full rounded-md bg-amber-500 hover:bg-amber-400 transition px-5 py-2.5 text-sm font-semibold text-stone-900 cursor-pointer" %>
<% end %>
