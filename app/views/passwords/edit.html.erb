<h2 class="text-2xl font-semibold mb-1">Set a new password</h2>
<p class="text-sm text-stone-600 mb-6">Choose something you can remember.</p>

<%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :password, "New password", class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>
  <div>
    <%= form.label :password_confirmation, "Repeat new password", class: "label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>
  <%= form.submit "Save", class: "btn btn-primary w-full" %>
<% end %>
