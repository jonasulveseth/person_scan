<h2 class="text-2xl font-semibold mb-1">Reset your password</h2>
<p class="text-sm text-stone-600 mb-6">We'll email you a link to set a new password.</p>

<%= form_with url: passwords_path, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :email_address, class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>
  <%= form.submit "Email reset instructions", class: "btn btn-primary w-full" %>
<% end %>

<p class="mt-6 text-sm text-stone-600">
  Remembered it after all? <%= link_to "Back to login", login_path, class: "text-amber-800 hover:underline" %>
</p>
